{
    "name": "rwb-mesh-delivery-frontend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "api:types": "openapi-typescript ../docs/openapi/frontend.yaml -o src/api/schema.generated.ts",
        "dev": "npm run api:types && vite",
        "typecheck": "npm run api:types && tsc --noEmit",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.15.0",
        "@xyflow/react": "^12.12.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-redux": "^9.3.1",
        "react-router": "^7.18.7"
    },
    "devDependencies": {
        "@types/node": "^22.20.7",
        "@types/react": "^19.3.3",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "openapi-typescript": "^7.13.0",
        "typescript": "5.9",
        "vite": "^8.3.8"
    }
}
